# Copy to the deployment secret store or a protected production environment file.
# Do not commit real secret values.
DEPLOYMENT_MODE=production
SECURE_COOKIES=true
CORS_ORIGINS=https://console.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Generate independent high-entropy values and store them in the platform secret manager.
CREDENTIAL_ENCRYPTION_KEY=<fernet-base64-key>
SCOPE_VALIDATION_KEY=<high-entropy-scope-validation-key>

# Enforces maker/checker dataset governance. The submitter cannot approve their own dataset.
AI_EVALUATOR_REQUIRE_INDEPENDENT_APPROVAL=true

# Live adapter egress is fail-closed: enumerate only approved target hostnames.
# Add private CIDRs only when the deployment has a reviewed private egress path.
AI_EVALUATOR_ADAPTER_TIMEOUT_SECONDS=20
AI_EVALUATOR_ADAPTER_MAX_CASES=100
AI_EVALUATOR_ADAPTER_MAX_CASE_BYTES=16384
AI_EVALUATOR_ADAPTER_MAX_REQUEST_BYTES=524288
AI_EVALUATOR_ADAPTER_MAX_RESPONSE_BYTES=524288
AI_EVALUATOR_ADAPTER_ALLOWED_HOSTS=ai-gateway.example.com
AI_EVALUATOR_ADAPTER_PRIVATE_NETWORKS=
AI_EVALUATOR_CLIENT_MAX_PACKAGE_AGE_HOURS=24
AI_EVALUATOR_GITHUB_OIDC_AUDIENCE=exposurescopex-evaluator
AI_EVALUATOR_GITHUB_OIDC_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks

# Keep disabled unless the organization has approved external AI data egress.
AI_EVALUATOR_PROVIDER=disabled
AI_EVALUATOR_MODEL=
AI_EVALUATOR_API_KEY=
AI_EVALUATOR_ALLOW_INTERNAL_DATA=false
