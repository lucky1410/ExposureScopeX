POSTGRES_DB=exposurescopex
POSTGRES_USER=exposurescopex
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql://exposurescopex:change-me-before-production@postgres:5432/exposurescopex
ARTIFACT_ROOT=/data/artifacts
NEXT_PUBLIC_API_URL=http://localhost:8001

# The independent evaluator is disabled until an administrator selects a
# provider and model. It never controls assessment scanners.
AI_EVALUATOR_PROVIDER=disabled
AI_EVALUATOR_MODEL=
AI_EVALUATOR_BASE_URL=https://api.openai.com/v1
AI_EVALUATOR_API_KEY=
AI_EVALUATOR_TIMEOUT_SECONDS=90
AI_EVALUATOR_ALLOW_INTERNAL_DATA=false
