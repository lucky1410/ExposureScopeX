# ExposureScopeX Web Application — Example Environment Configuration

# Database
POSTGRES_USER=exposurescopex
POSTGRES_PASSWORD=change_me
POSTGRES_DB=exposurescopex
DATABASE_URL=postgresql+asyncpg://exposurescopex:change_me@postgres:5432/exposurescopex
DATABASE_NULL_POOL=false

# Redis
REDIS_PASSWORD=replace_with_a_random_32_char_secret
REDIS_URL=redis://:replace_with_a_random_32_char_secret@redis:6379/0

# Backend
ENVIRONMENT=development
SECRET_KEY=replace_with_a_random_64_char_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
ALLOW_PUBLIC_REGISTRATION=false
BACKEND_CORS_ORIGINS=["http://localhost:3001","http://localhost:8081","http://frontend:3000"]

# Optional API Keys
ANTHROPIC_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXTAUTH_SECRET=replace_with_a_random_64_char_secret
NEXTAUTH_URL=http://localhost:3001
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8001
FRONTEND_PORT=3001
NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8444
NGINX_BIND_ADDRESS=127.0.0.1
HOST_UID=501
HOST_GID=20

# Data / Scanning
SEED_DEMO_DATA=false
IMPORT_REAL_DATA=false
# Required only for an explicit demo seed or filesystem import; never reuse in production.
BOOTSTRAP_ADMIN_PASSWORD=
HOME=/app/runtime
NUCLEI_TEMPLATE_REPOS=
NUCLEI_TEMPLATES_DIR=/app/runtime/nuclei-templates
NUCLEI_COMMUNITY_TEMPLATES_DIR=/app/runtime/nuclei-templates-community
NUCLEI_TEMPLATE_AUTOUPDATE=true
NUCLEI_TEMPLATE_REFRESH_HOURS=24
WORKER_QUEUES=scans-web,scans-api,scans-artifact,scans-cloud,scans-mobile,scans
WORKER_CONCURRENCY=2
SCAN_STALL_WARNING_SECONDS=600
MAX_ENUMERATION_TARGETS=
WEB_WORKER_CONCURRENCY=2
API_WORKER_CONCURRENCY=2
ARTIFACT_WORKER_CONCURRENCY=1
CLOUD_WORKER_CONCURRENCY=1
MOBILE_WORKER_CONCURRENCY=1
CORE_WORKER_CONCURRENCY=1
STALE_SCAN_MINUTES=10
SCAN_ARTIFACT_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=90
DEFAULT_MAX_ACTIVE_SCANS_PER_ORG=2
DEFAULT_MAX_QUEUED_SCANS_PER_ORG=25
ENFORCE_WORKER_CAPABILITIES=true
WORKER_CAPABILITY_TTL_SECONDS=120
SCAN_EXECUTOR=process
SCANNER_IMAGE_IDENTITY=exposurescopex-worker:local
SCAN_JOB_IMAGE=exposurescopex-worker:latest
SCAN_JOB_NAMESPACE=exposurescopex
SCAN_JOB_SERVICE_ACCOUNT=exposurescopex-scanner
SCAN_JOB_SECRET_NAME=exposurescopex-runtime
SCAN_JOB_CONFIG_MAP=
SCAN_JOB_RESULTS_PVC=exposurescopex-results
SCAN_JOB_ACTIVE_DEADLINE_SECONDS=86400
SCAN_JOB_ALLOW_NET_RAW=false
ARTIFACT_STORAGE_BACKEND=database
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=exposurescopex-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=exposurescopex
S3_SERVER_SIDE_ENCRYPTION=AES256
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
GRAFANA_PORT=3002
MOBILE_DYNAMIC_ADAPTER_URL=
MOBILE_DYNAMIC_API_KEY=
KUBERNETES_RUNTIME_ADAPTER_URL=
KUBERNETES_RUNTIME_API_KEY=
RUNTIME_ADAPTER_ALLOWED_HOSTS=host.docker.internal,mobile-lab,kubernetes-runtime
BACKUP_REPLICA_URI=
BACKUP_REPLICA_ENDPOINT_URL=
BACKUP_REPLICA_SSE=AES256
NUCLEI_ENABLE_HEADLESS=true
NUCLEI_ENABLE_CODE_TEMPLATES=false
NUCLEI_EXCLUDE_TAGS=dos,fuzz,intrusive
NUCLEI_EXTRA_FLAGS=
NUCLEI_EXTRA_TEMPLATE_REPOS=
# Light remains fail-forward: Nuclei exits before the enclosing stage deadline.
NUCLEI_STAGE_TIMEOUT_LIGHT=1860
NUCLEI_STAGE_TIMEOUT_MEDIUM=3660
NUCLEI_STAGE_TIMEOUT_AGGRESSIVE=7260
NUCLEI_TOOL_TIMEOUT_LIGHT=1800
NUCLEI_TOOL_TIMEOUT_MEDIUM=3600
NUCLEI_TOOL_TIMEOUT_AGGRESSIVE=7200
EXPOSURESCOPEX_RETAIN_REPOSITORY_CHECKOUT=false
